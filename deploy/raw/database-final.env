# Copy this to /var/www/database-final/.env on app1 and fill in every value.
# Same values as deploy/digitalocean/.env.digitalocean used for this app's
# `environment:` block — reshaped into a real .env file, since native PHP
# reads .env directly rather than getting variables injected by Docker
# Compose. Generate secrets with the same openssl commands noted in
# deploy/digitalocean/.env.digitalocean.example.

APP_NAME="Smart Hospital Management System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_ME
APP_URL=https://YOUR_DOMAIN

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
# Use postgres-db's private IP if the droplets share a VPC, otherwise its
# public IP (see step 1 of DEPLOYMENT-RAW.md) — same as the Docker setup.
DB_PORT=5432
DB_DATABASE=smart_hospital
DB_USERNAME=smart_hospital
DB_PASSWORD=REPLACE_ME

MONGODB_URI=mongodb://smart_hospital:REPLACE_ME@MONGO_HOST:27017/?authSource=admin
MONGODB_DATABASE=smart_hospital_docs

REDIS_CLIENT=phpredis
REDIS_HOST=REDIS_HOST
REDIS_PASSWORD=REPLACE_ME
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_BUS_DB=2

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

CENTRAL_SERVICE_BASE_URL=http://CENTRAL_SERVICE_HOST:8100
CENTRAL_SERVICE_API_KEY=REPLACE_ME

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

MAIL_MAILER=log
