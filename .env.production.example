# Copy to .env.production and fill in every value below, then:
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d --build
#
# Generate the two APP_KEY values AFTER the containers exist (they need the
# image built first) — see DEPLOYMENT.md step 4. Generate strong random
# passwords for everything else, e.g.: openssl rand -base64 32

# Postgres — shared by both apps
POSTGRES_USER=smart_hospital
POSTGRES_PASSWORD=

# MongoDB — shared by both apps
MONGO_USER=smart_hospital
MONGO_PASSWORD=

# Redis — shared by both apps (bus, cache, session, queue)
REDIS_PASSWORD=

# Database-final (Application Server)
DATABASE_FINAL_APP_KEY=
# The public hostname visitors actually use (see step 7) — e.g.
# https://smarthospital.sovandara.lol. LAN access via http://192.168.0.100:8000
# keeps working regardless of what's set here; this just affects generated
# URLs/assets.
DATABASE_FINAL_APP_URL=
# Host port Database-final is published on (central-service stays internal-only)
DATABASE_FINAL_PORT=8000

# central-service
CENTRAL_SERVICE_APP_KEY=

# Shared secret for service-to-service REST calls — same value used by both
# apps, doesn't need to be anything specific, just long and random.
CENTRAL_SERVICE_API_KEY=

# Cloudflare R2 (optional) — leave all blank to fall back to local disk storage.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Cloudflare Tunnel — public HTTPS access with no router port-forwarding.
# From your token from the Cloudflare Zero Trust dashboard (see DEPLOYMENT.md
# step 7); leave blank and remove the `cloudflared` service from
# docker-compose.production.yml if you only need LAN access.
CLOUDFLARE_TUNNEL_TOKEN=
